{
  "expo": {
    "name": "time-tracker",
    "slug": "time-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "@/assets/images/icon.png",
    "scheme": "time-tracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.giftezra.ifeanyi.timetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.time_tracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-router"],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification.jpg",
          "color": "#ffffff",
          "projectId": "22b76193-23d6-4e60-b879-1b93f8613fe8"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true,
          "enableApplePay": true,
          "merchantIdentifier": "merchant.com.time-tracker",
          "publishableKey": "pk_test_51NK8SeKs3nf7cE2WBk18TrdJPOLqvJzYyxmlHFFmGNUmk78TsVVimg3YnGSVLkMhYoQWr1yBR21cbdoKfrb8zmmP00QauAcvF1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "22b76193-23d6-4e60-b879-1b93f8613fe8"
      },
      "stripe": {
        "publishableKey": "pk_test_51NK8SeKs3nf7cE2WBk18TrdJPOLqvJzYyxmlHFFmGNUmk78TsVVimg3YnGSVLkMhYoQWr1yBR21cbdoKfrb8zmmP00QauAcvF1"
      },
      "url": {
        "scheme": "time-tracker",
        "host": "13cb-2001-bb6-cf2d-3f00-5485-2dc5-2fe4-34e.ngrok-free.app"
      }
    }
  }
}
